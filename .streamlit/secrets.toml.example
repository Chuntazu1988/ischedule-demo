# Template for .streamlit/secrets.toml — copy this file to secrets.toml and
# fill in real password hashes (secrets.toml itself is gitignored).
#
# Generate a bcrypt hash for a password with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
#
# role must be one of:
#   "admin"  — full read/write access to the whole system.
#   "viewer" — ONLY the personal employee screen (mark arrival + see today's
#              assigned tasks). Requires employee_name to exactly match that
#              person's "שם" column value in employees_clean.xlsx. Give each
#              real employee their OWN account — don't share one.

[users.example_admin]
name = "Display Name"
password_hash = "PASTE_BCRYPT_HASH_HERE"
role = "admin"

[users.example_employee]
name = "Display Name"
password_hash = "PASTE_BCRYPT_HASH_HERE"
role = "viewer"
employee_name = "Exact Name As In employees_clean.xlsx"
